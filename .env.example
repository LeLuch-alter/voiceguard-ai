# Copy this file to .env and fill in the values.
# In production the variables are set in Vercel (Environment Variables).

# GROQ API key (required)
GROQ_API_KEY=

# Company name, injected into the AI system prompt (optional)
COMPANY_NAME=

# Telegram notifications for new requests (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Allowed origins for the API (CORS), comma-separated. Optional.
# By default localhost and *.vercel.app are allowed. Set your own domain
# if the frontend lives on a separate address, e.g.: https://example.com
ALLOWED_ORIGINS=
