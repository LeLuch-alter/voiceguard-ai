# Скопируйте этот файл в .env и заполните значения.
# В продакшене переменные задаются в настройках Vercel (Environment Variables).

# Ключ GROQ API (обязательно)
GROQ_API_KEY=

# Название компании, подставляется в системный промпт ИИ (необязательно)
COMPANY_NAME=

# Уведомления о заявках в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
