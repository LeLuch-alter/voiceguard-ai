# Скопируйте этот файл в .env и заполните значения.
# В продакшене переменные задаются в настройках Vercel (Environment Variables).

# Ключ GROQ API (обязательно)
GROQ_API_KEY=

# Название компании, подставляется в системный промпт ИИ (необязательно)
COMPANY_NAME=

# Уведомления о заявках в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Разрешённые источники для API (CORS), через запятую. Необязательно.
# По умолчанию разрешены localhost и *.vercel.app. Укажите свой домен,
# если фронтенд живёт на отдельном адресе, напр.: https://example.com
ALLOWED_ORIGINS=
